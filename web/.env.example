# NCTprop.com Web Frontend Environment
# In production on Cloudflare Pages, leave VITE_API_URL empty if routing /api via Cloudflare Worker routes or Pages Functions.
VITE_API_URL=http://localhost:8787

# Firebase Free Tier Config (Optional for SMS/Phone Auth)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=nctprop.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nctprop
VITE_FIREBASE_STORAGE_BUCKET=nctprop.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
