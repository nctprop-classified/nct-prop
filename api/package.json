{
  "name": "@nctprop/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply nctprop-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply nctprop-db --remote",
    "db:seed:local": "wrangler d1 execute nctprop-db --local --file=./migrations/0002_seed_sample_data.sql",
    "db:seed:prod": "wrangler d1 execute nctprop-db --remote --file=./migrations/0002_seed_sample_data.sql"
  },
  "dependencies": {
    "hono": "^4.3.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240512.0",
    "typescript": "^5.4.0",
    "wrangler": "^3.57.0"
  }
}
