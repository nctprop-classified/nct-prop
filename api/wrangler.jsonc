{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nctprop-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-05-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nctprop-db",
      "database_id": "08c7ae2c-6993-44d2-b9cc-13139365e4e8",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "nctprop-images"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGINS": "https://nctprop.com,http://localhost:5173,http://localhost:3000",
    "R2_PUBLIC_DOMAIN": "https://images.nctprop.com"
  }
}
